<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
    "struts-config_1_3.dtd">

<struts-config>

	<!-- ================= Form Bean Definitions ================= -->
	<form-beans>
		<!-- Declare seus ActionForms aqui quando necessário -->
	</form-beans>

	<!-- ================= Global Forwards ================= -->
	<global-forwards>
		<forward name="home" path="/home.do" />
	</global-forwards>

	<!-- ================= Action Mappings ================= -->
	<action-mappings>
		<!-- Mapeia a URL /home para renderizar a definição "home" do Tiles -->
		<action path="/home"
			type="org.apache.struts.actions.ForwardAction" parameter="home" />



		<!-- Configuração da Action de Login baseada em DispatchAction -->
		<action path="/publico/admin/login"
			type="br.com.srcsoftware.web.atlantis.LoginAction"
			parameter="method" scope="session">

			<forward name="telaLogin" path="/paginas/publico/adm/login.jsp" />
			<forward name="sucesso" path="/home.src" />
		</action>
	</action-mappings>



	<!-- ================= Controller Configuration ================= -->
	<!-- Define o TilesRequestProcessor para suportar o Apache Tiles no Struts 
		1.3 -->
	<controller
		processorClass="org.apache.struts.tiles.TilesRequestProcessor" />

	<!-- ================= Message Resources ================= -->
	<message-resources parameter="ApplicationResources" />

	<!-- ================= Plugins (Apache Tiles) ================= -->
	<plug-in className="org.apache.struts.tiles.TilesPlugin">
		<set-property property="definitions-config"
			value="/WEB-INF/tiles-defs.xml" />
		<set-property property="moduleAware" value="true" />
		<set-property property="definitions-parser-validate"
			value="true" />
	</plug-in>

</struts-config>