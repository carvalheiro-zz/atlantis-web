<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
       "-//Apache Software Foundation//DTD Tiles Configuration 1.3//EN"
       "http://struts.apache.org/dtds/tiles-config_1_3.dtd">

<tiles-definitions>

    <!-- Definição Base (Template Principal) -->
    <definition name="template.principal" path="/templates/adm/template.jsp">
        <put name="header" value="/templates/adm/header.jsp" />
        <put name="menu"   value="/templates/adm/menu.jsp" />
        <put name="footer" value="/templates/adm/footer.jsp" />
        <put name="body"   value="" />
    </definition>


	<!--============================================================================================= -->
	<!--= INICIO ========================== USER MANAGER ==== NÃO ALTERAR =========================== -->
	<!--============================================================================================= -->
    <!-- Exemplo de Tela Filha (Estende o layout base e sobrescreve apenas o body) -->
    <definition name=".home" extends="template.principal">
        <put name="body" value="/paginas/restrito/home.jsp" />
    </definition>

	<definition name=".telaCampos" extends="template.principal">
		<put name="body" value="/paginas/restrito/adm/tela/tela-campos.jsp" />
	</definition>
	<definition name=".telaLista" extends="template.principal">
		<put name="body" value="/paginas/restrito/adm/tela/tela-lista.jsp" />
	</definition>
</tiles-definitions>